# URL publique de l'app (obligatoire en prod, utilisée pour les cookies/CSRF et les liens d'invitation)
ORIGIN=https://cerveau.exemple.fr

# Nom affiché dans l'interface
APP_NAME=Second cerveau

# Dossier des données (base SQLite, pièces jointes, clés VAPID). Monté en volume Docker.
DATA_DIR=./data

# Port d'écoute du serveur Node
PORT=3000

# Fuseau horaire du foyer (pour les rappels)
TZ=Europe/Paris
